# Secrets — never commit. A Gemini key leaked through a notebook once already.
.env
.env.*
!.env.example

# Per-run working dirs (transcripts, frames, screenshots) — can be hundreds of MB
runs/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Notebook outputs: strip before committing (`nbstripout --install`)
# Outputs are where credentials and large images sneak into git history.

# Runtime artifacts written into the repo dir by app.py / quickstart.py.
# Untracked files do not normally block a pull, but they make `git status`
# noisy and would collide the moment a file of the same name is committed.
server.log
cloudflared
cloudflared.log
