# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
#
#   cp .env.example .env
#   chmod 600 .env

# --- keys ------------------------------------------------------------------- #
# Google AI Studio (https://aistudio.google.com/apikey) — vision + judge.
# Restrict the key to the "Generative Language API" to limit blast radius.
GEMINI_API_KEY=

# Together — OPTIONAL. The Gemini key above can drive all three roles.
# Only needed if you want structured output on Llama-3.3-70B instead.
# NOTE: Together's serverless tier has NO vision models; they need a paid
# dedicated endpoint. Anything image-related must go to Gemini.
TOGETHER_API_KEY=

# --- role wiring ------------------------------------------------------------ #
# Providers: vllm | ollama | together | openai | hf | gemini | anthropic
# "text" = the STRUCTURED OUTPUT role: prose -> validated JSON, and revisions.
# (In the original, the plain-text `generate` client is never actually called.)
TO_TEXT_PROVIDER=gemini
TO_TEXT_MODEL=gemini-3.5-flash
# For Together instead:
#   TO_TEXT_PROVIDER=together
#   TO_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

TO_VISION_PROVIDER=gemini
TO_VISION_MODEL=gemini-3.5-flash

TO_JUDGE_PROVIDER=gemini
TO_JUDGE_MODEL=gemini-3.5-flash

# --- solver ----------------------------------------------------------------- #
# auto = CUDA when a GPU with enough free VRAM is present, else CPU.
TO_BACKEND=auto
# Refuse to call CUDA "available" below this much free VRAM (MiB). A shared GPU
# can have 100 MiB free, pass a toy allocation, then OOM on the first real solve.
TO_MIN_VRAM_MB=3072
# Pin the mesh explicitly; otherwise it is chosen from detected VRAM.
# TO_MESH=96,48,48

# --- run behaviour ---------------------------------------------------------- #
TO_MAX_RUNS=5
TO_WEB_PORT=8080
TO_FRAME_EVERY=5

# Gemini 3.x spends "thinking" tokens out of maxOutputTokens. Set to 0 to turn
# reasoning off for lower latency; leave unset for better critiques.
# TO_GEMINI_THINKING_BUDGET=0

# Structured-output strategy. Auto-selected per provider: TOOLS for Gemini
# (whose OpenAI-compat endpoint rejects JSON_SCHEMA), JSON_SCHEMA otherwise.
# TO_INSTRUCTOR_MODE=TOOLS

# DO NOT set TO_AGENTS_ROOT or PYFANTOM_PATH here unless you mean it. A stale
# TO_AGENTS_ROOT copied from another checkout makes `import agents` resolve to
# that other tree, so you end up debugging code you did not edit.
